    "locales": {
      "en": {
        "35e933725dd8e5e778e3ad71 acceptPlayerMessage": "",
        "35e933725dd8e5e778e3ad71 changeQuestMessageText": "",
        "35e933725dd8e5e778e3ad71 completePlayerMessage": "",
