    "locales": {
      "en": {
        "name": "Panzer Arms SCR-XII 12ga shotgun",
        "shortName": "SCR-XII",
        "description": "A semi-automatic 12 gauge shotgun built by Panzer Arms of Turkey in the image of the FN SCAR: the same lower, folding stock, flip-up sights and modular rails, with a 12 gauge upper receiver, a 406mm barrel threaded for Saiga-12 pattern muzzle devices and dedicated Mk12 box magazines. Most FN SCAR stocks, rails and accessories fit it."
      },
      "po": {
        "name": "Escopeta Panzer Arms SCR-XII 12ga",
        "shortName": "SCR-XII",
        "description": "Escopeta semiautomática calibre 12 da turca Panzer Arms, feita à imagem da FN SCAR: o mesmo lower, coronha dobrável, miras rebatíveis e trilhos modulares, com upper receiver de calibre 12, cano de 406 mm com rosca para bocais do padrão Saiga-12 e carregadores Mk12 próprios. Aceita a maioria das coronhas, trilhos e acessórios da FN SCAR."
      }
