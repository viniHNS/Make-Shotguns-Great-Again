    "locales": {
      "en": {
        "name": "ATI Omni Hybrid Maxx .410 semi-automatic shotgun",
        "shortName": "Omni Hybrid",
        "description": "The ATI Omni Hybrid Maxx is an AR-15 pattern semi-automatic shotgun in .410 bore, built on a mil-spec lower of steel-reinforced polymer. It runs a short-stroke piston with balanced gas, and any standard AR charging handle fits. The chamber takes 2.5-inch (65 mm) shells only, fed from 5 or 15 round box magazines. Complete, it weighs about 6.5 lb (2.95 kg)."
      },
      "po": {
        "name": "Escopeta semiautomática ATI Omni Hybrid Maxx .410",
        "shortName": "Omni Hybrid",
        "description": "A ATI Omni Hybrid Maxx é uma escopeta semiautomática no padrão AR-15, calibre .410, construída sobre um lower mil-spec de polímero reforçado com aço. Usa pistão de curso curto com gás balanceado, e qualquer alavanca de armar de AR serve. A câmara aceita apenas cartuchos de 2,5 pol (65 mm), alimentados por carregadores de 5 ou 15 cartuchos. Completa, pesa cerca de 6,5 lb (2,95 kg)."
      },
      "ru": {
        "name": "Самозарядное ружьё ATI Omni Hybrid Maxx .410",
        "shortName": "Omni Hybrid",
        "description": "ATI Omni Hybrid Maxx — самозарядное ружьё калибра .410 на платформе AR-15, построенное на нижней части mil-spec из полимера, усиленного сталью. Использует поршень с коротким ходом и сбалансированным газоотводом; подходит любая рукоятка заряжания от AR. Патронник принимает только патроны длиной 2,5 дюйма (65 мм); питание из коробчатых магазинов на 5 или 15 патронов. В сборе весит около 6,5 фунта (2,95 кг)."
      }
    },
