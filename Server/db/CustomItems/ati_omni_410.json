    "locales": {
      "en": {
        "name": "ATI Omni Hybrid .410 upper receiver",
        "shortName": "Omni .410 upper",
        "description": "The matte black aluminum upper receiver of the ATI Omni Hybrid .410. It keeps the standard AR-15 ejection port with dust cover, deflector and forward assist, and has a continuous Picatinny rail on top. The bolt carrier runs on a short-stroke piston."
      },
      "po": {
        "name": "Upper receiver ATI Omni Hybrid .410",
        "shortName": "Omni .410 upper",
        "description": "O upper receiver de alumínio preto fosco da ATI Omni Hybrid .410. Mantém a janela de ejeção padrão do AR-15 com tampa de poeira, defletor e forward assist, e tem um trilho Picatinny contínuo na parte de cima. O ferrolho funciona com pistão de curso curto."
      },
      "ru": {
        "name": "Верхняя часть ствольной коробки ATI Omni Hybrid .410",
        "shortName": "Omni .410 верх",
        "description": "Матово-чёрная алюминиевая верхняя часть ствольной коробки ATI Omni Hybrid .410. Сохраняет стандартное окно выброса AR-15 с пылезащитной крышкой, дефлектором и форвард-ассистом; сверху сплошная планка Пикатинни. Затворная рама работает от поршня с коротким ходом."
      }
    },
