    "locales": {
      "en": {
        "name": "Rock Island Armory VR80 12ga semi-automatic shotgun",
        "shortName": "VR80",
        "description": "The VR80 is a gas-operated, magazine-fed 12 gauge semi-automatic shotgun marketed by Rock Island Armory. Its AR-style layout brings familiar controls and a flat-top optics rail to a shotgun platform. Detachable box magazines keep reloads straightforward, while the M-LOK handguard provides mounting points for accessories. This factory configuration uses a 508mm barrel and a stock with an integrated pistol grip."
      },
      "po": {
        "name": "Escopeta semi-automática Rock Island Armory VR80 12ga",
        "shortName": "VR80",
        "description": "A VR80 é uma escopeta semiautomática calibre 12, operada a gás e alimentada por carregadores, comercializada pela Rock Island Armory. O formato inspirado no AR combina comandos familiares com um trilho superior para miras. Os carregadores destacáveis facilitam as recargas, enquanto o guarda-mão M-LOK permite instalar acessórios. Esta configuração de fábrica utiliza um cano de 508 mm e uma coronha com punho integrado."
      }
    },
