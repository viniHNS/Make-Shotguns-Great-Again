      "en": {
        "name": "Taurus Raging Judge .410 revolver",
        "shortName": "Raging Judge",
        "description": "A heavy-frame Taurus revolver adapted for .410/76 shotshells. This five-shot configuration has an integral rubber grip. It can fire in single-action or double-action mode."
      },
      "po": {
        "name": "Revólver Taurus Raging Judge .410",
        "shortName": "Raging Judge",
        "description": "Revólver Taurus de armação pesada, adaptado para cartuchos .410/76. Esta configuração de cinco tiros tem empunhadura de borracha integral. Permite disparos em ação simples ou dupla."
      },
      "ru": {
        "name": "Револьвер Taurus Raging Judge .410",
        "shortName": "Raging Judge",
        "description": "Револьвер Taurus на тяжёлой рамке, переделанный под патроны .410/76. Эта пятизарядная версия имеет неразборную резиновую рукоятку. Стреляет как самовзводом, так и с предварительным взведением курка."
      }
